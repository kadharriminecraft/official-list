if(features.art){sum+=`<span class="it">${ac}</span> add art, <span class="wt">${arc}</span> replace. `;if(asc)sum+=`<span class="nc">${asc}</span> skip. `;if(auc)sum+=`<span class="nc">${auc}</span> n/a. `}
