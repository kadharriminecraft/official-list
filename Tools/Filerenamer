document.getElementById('runBtn').addEventListener('click',async()=>{
if(isRunning)return;const toProc=previewData.filter(p=>p.rename||p.applyArt||p.applyArtist);if(toProc.length===0)return;
if(!confirm(`Modify ${toProc.length} file${toProc.length!==1?'s':''}? This cannot be undone.`))return;
