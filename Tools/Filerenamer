try{
const file=await handle.getFile();let content;
if(applyArt||applyArtist){const buf=await file.arrayBuffer();content=modifyTags(buf,{artist:applyArtist?artistName:null,artBytes:applyArt?imageData.bytes:null,artMime:applyArt?imageData.mime:null})}
else content=file;
let lb='';if(applyArt)lb+=' <span class="it">[art]</span>';if(applyArtist)lb+=` <span style="color:#c084fc">[artist:${artistName}]</span>`;
if(rename){
let newHandle;if(sourceType==='folder'){newHandle=await dirHandle.getFileHandle(newName,{create:true})}else{newHandle=handle;await handle.move(newName)}
const w=await newHandle.createWritable();await w.write(content);await w.close();
if(sourceType==='folder')await dirHandle.removeEntry(oldName);
log+=`<div class="pi"><div class="pi-ic">✅</div><div class="pi-d"><div class="pi-n">${newName}</div><div class="pi-m"><span class="m-r">was: ${oldName}</span>${lb}</div></div></div>`;
}else{
const w=await handle.createWritable();await w.write(content);await w.close();
log+=`<div class="pi"><div class="pi-ic">✅</div><div class="pi-d"><div class="pi-n">${oldName}</div><div class="pi-m">${lb}</div></div></div>`}
}catch(e){errors++;log+=`<div class="pi"><div class="pi-ic">❌</div><div class="pi-d"><div class="pi-n" style="color:#ef4444">${oldName}</div><div class="pi-m"><span class="et">${e.message}</span></div></div></div>`}
done++;document.getElementById('progBar').style.width=(done/total*100)+'%';status.innerText=`Processing ${done} of ${total}…`;await new Promise(r=>setTimeout(r,0))}

document.getElementById('previewList').innerHTML=log;
if(errors>0){status.innerText=`Done — ${total-errors} ok, ${errors} error${errors!==1?'s':''}.`;status.className='wt'}
else{status.innerText=`✓ Done — ${total} file${total!==1?'s':''} processed.`;status.className='st'}
btn.innerText='Finished';isRunning=false});
</script>
