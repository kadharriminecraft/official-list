<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Music Toolkit</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#0f0f0f;color:#e0e0e0;padding:24px;max-width:760px;margin:0 auto;line-height:1.5}
h1{font-size:1.5rem;margin-bottom:4px}
.sub{color:#888;font-size:.9rem;margin-bottom:20px}
.card{background:#1a1a1a;border:1px solid #2a2a2a;padding:20px;border-radius:12px;margin-bottom:16px}
.ct{font-size:1.05rem;font-weight:700;margin-bottom:14px}
label{display:block;margin:12px 0 6px;font-weight:600;font-size:.88rem;color:#ccc}
input[type=text],input[type=number],select{width:100%;padding:10px 12px;border-radius:8px;border:1px solid #333;background:#222;color:#eee;font-size:.95rem}
input:focus,select:focus{outline:none;border-color:#d32f2f}
.btn{width:100%;padding:12px 16px;border-radius:8px;border:none;font-weight:700;font-size:.95rem;cursor:pointer;margin-top:12px;transition:opacity .2s,transform .1s}
.btn:active{transform:scale(.98)}
.btn-p{background:#d32f2f;color:#fff}
.btn-s{background:#2563eb;color:#fff}
.btn-d{background:#444;color:#fff}
.btn:disabled{background:#444;cursor:not-allowed;opacity:.5}
.sr{display:flex;gap:12px}
.sr .btn{margin-top:0}
.tr{display:flex;gap:12px;margin-bottom:4px}
.tc{flex:1;background:#222;border:2px solid #333;border-radius:10px;padding:14px;cursor:pointer;transition:.2s;text-align:center;user-select:none}
.tc.active{border-color:#d32f2f;background:#2a1515}
.tc .ic{font-size:1.4rem}
.tc .lb{font-weight:700;font-size:.82rem;margin-top:4px}
.hint{font-size:.8rem;color:#777;margin-top:6px}
.pv{max-height:380px;overflow-y:auto;background:#0a0a0a;border:1px solid #222;border-radius:8px}
.pv::-webkit-scrollbar{width:6px}
.pv::-webkit-scrollbar-thumb{background:#444;border-radius:3px}
.pi{display:flex;align-items:center;gap:12px;padding:12px 14px;border-bottom:1px solid #222}
.pi:last-child{border-bottom:none}
.pi-ic{font-size:1.2rem}
.pi-d{flex:1;min-width:0}
.pi-n{font-weight:600;color:#fff;font-size:.9rem;word-break:break-all}
.pi-m{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.pi-m span{font-size:.72rem;padding:3px 8px;border-radius:4px;background:#222}
.m-r{color:#888}.m-a{color:#60a5fa}.m-ar{color:#c084fc}.m-s{color:#555}.m-w{color:#f59e0b}
.nc{color:#555}.wt{color:#f59e0b}.et{color:#ef4444}.st{color:#22c55e}.it{color:#60a5fa}
.prog{height:6px;background:#333;border-radius:3px;overflow:hidden;margin-top:12px}
.pb{height:100%;width:0;background:linear-gradient(90deg,#d32f2f,#f44336);transition:width .3s}
#status{text-align:center;margin-top:10px;font-weight:600;font-size:.9rem}
.hidden{display:none!important}
.fc{margin-top:10px;padding:8px 12px;background:#0a0a0a;border-radius:6px;font-size:.85rem;color:#7dd87d;display:flex;justify-content:space-between;align-items:center}
.cr{display:flex;align-items:center;gap:8px;margin:10px 0}
.cr input[type=checkbox]{width:18px;height:18px;accent-color:#d32f2f;cursor:pointer}
.cr label{margin:0;cursor:pointer}
.wb{background:#2a1a00;border:1px solid #f59e0b33;color:#f59e0b;padding:10px 14px;border-radius:8px;font-size:.85rem;margin-bottom:16px;font-weight:600}
.cw{width:320px;height:320px;margin:16px auto;border-radius:12px;overflow:hidden;border:2px solid #333;background:#000;cursor:grab;touch-action:none}
.cw:active{cursor:grabbing}
#cc{display:block}
.cc{display:flex;align-items:center;gap:8px;margin-bottom:10px;background:#222;padding:8px;border-radius:8px}
.bs{padding:6px 12px;border-radius:6px;border:1px solid #333;background:#333;color:#fff;cursor:pointer;font-weight:700;width:auto;margin:0}
.bs:hover{background:#444}
#zs{flex:1;margin:0;accent-color:#d32f2f}
.cpc{display:flex;gap:16px;align-items:center;background:#0a0a0a;padding:12px;border-radius:8px;margin-bottom:12px;border:1px solid #222}
.cpc img{width:80px;height:80px;border-radius:6px;object-fit:cover;border:1px solid #333}
.cpc .info{font-size:.85rem;color:#aaa}
.sd{border-top:1px solid #333;margin:16px 0;padding-top:4px}
.drop-zone{border:2px dashed #333;border-radius:12px;padding:20px;text-align:center;color:#777;margin-top:12px;transition:.2s}
.drop-zone.dragover{border-color:#d32f2f;background:#2a1515;color:#fff}
</style>
</head>
<body>
<h1>🎵 Music Toolkit</h1>
<p class="sub">Rename tracks, embed album art, and set artist tags — runs entirely in your browser.</p>
<div class="wb">⚠️ Files are modified in-place. This cannot be undone. Back up first.</div>

<div class="card">
<div class="ct">📁 Step 1 — Pick Music Folder or Files</div>
<div class="sr">
<button class="btn btn-s" id="pickFolder">Choose Folder</button>
<button class="btn btn-s" id="pickFiles">Select Files</button>
<button class="btn btn-d" id="clearFiles">Clear List</button>
</div>
<div id="fileCount" class="fc hidden"></div>
<div class="drop-zone" id="dropZone">Or drag & drop music files here</div>
</div>

<div class="card">
<div class="ct">⚙️ Step 2 — Choose Actions</div>
<div class="tr">
<div class="tc active" id="tRename" data-f="rename"><div class="ic">✏️</div><div class="lb">Rename Files</div></div>
<div class="tc" id="tArt" data-f="art"><div class="ic">🖼️</div><div class="lb">Add Album Art</div></div>
<div class="tc" id="tArtist" data-f="artist"><div class="ic">🎤</div><div class="lb">Set Artist</div></div>
</div>
<div id="renameSection">
<label>Rename Mode</label>
<select id="mode">
<option value="track">Remove leading track numbers</option>
<option value="start">Remove X characters from start</option>
<option value="end">Remove X characters from end</option>
</select>
<div id="charOptions" class="hidden">
<label>Characters to remove</label>
<input type="number" id="count" value="2" min="1" max="50">
</div>
<label>Only rename if name starts with (optional)</label>
<input type="text" id="match" placeholder="e.g. 01, Track, [">
</div>
<div id="artSection" class="hidden">
<div class="sd"></div>
<label>Choose & Crop Cover Image</label>
<button class="btn btn-s" id="pickImage">Select Image</button>
<input type="file" id="imageInput" accept="image/jpeg,image/png,image/webp" class="hidden">
<div id="cropperContainer" class="hidden">
<div class="cw"><canvas id="cc" width="320" height="320"></canvas></div>
<div class="cc">
<button class="bs" id="zOut">−</button>
<input type="range" id="zs" min="0.1" max="5" step="0.01" value="1">
<button class="bs" id="zIn">+</button>
<button class="bs" id="zReset">Reset</button>
</div>
<div class="hint">Drag to pan, slider/buttons to zoom. Cropped to 1:1 square.</div>
</div>
<div class="cr"><input type="checkbox" id="skipArt" checked><label for="skipArt">Skip files that already have album art</label></div>
<div class="hint">Art embedding supports MP3 (ID3v2). Other formats skipped for art.</div>
</div>
<div id="artistSection" class="hidden">
<div class="sd"></div>
<label>Artist Name</label>
<input type="text" id="artistName" placeholder="e.g. The Beatles">
<div class="cr"><input type="checkbox" id="skipArtist"><label for="skipArtist">Skip files that already have an artist tag</label></div>
<div class="hint">Artist tag supports MP3 (ID3v2 TPE1). UTF-16 encoded.</div>
</div>
<button class="btn btn-p" id="previewBtn" disabled>Preview Changes</button>
</div>

<div class="card hidden" id="previewCard">
<div class="ct">👁️ Step 3 — Preview & Confirm</div>
<div id="coverPreview" class="cpc hidden">
<img id="coverThumb" src="" alt="Cover">
<div class="info"><div style="font-weight:700;color:#fff">Album Art Preview</div><div>This 1:1 crop will be embedded.</div></div>
</div>
<div class="pv" id="previewList"></div>
<div id="summary" class="hint" style="margin-top:10px;font-size:.85rem"></div>
<button class="btn btn-p" id="runBtn" disabled>⚠️ Apply Changes to Files</button>
<div class="prog hidden" id="progWrap"><div class="pb" id="progBar"></div></div>
<div id="status"></div>
</div>

<script>
let dirHandle=null,fileHandles=[],sourceType=null,isRunning=false,isScanning=false,previewData=[],imageData=null;
let features={rename:true,art:false,artist:false};
let currentObjectUrl=null,coverThumbUrl=null;
const MUSIC_EXT=['.mp3','.flac','.m4a','.wav','.ogg','.wma','.aac','.opus'];
const TAG_EXT=['.mp3'];

// Cropper
const cc=document.getElementById('cc'),cctx=cc.getContext('2d');
const cs={img:null,scale:1,ox:0,oy:0,size:320,drag:false,lx:0,ly:0,min:0.1,max:5};

function drawC(){cctx.fillStyle='#000';cctx.fillRect(0,0,cs.size,cs.size);if(cs.img)cctx.drawImage(cs.img,cs.ox,cs.oy,cs.img.width*cs.scale,cs.img.height*cs.scale)}
function fitC(){if(!cs.img)return;cs.scale=Math.max(cs.size/cs.img.width,cs.size/cs.img.height);cs.ox=(cs.size-cs.img.width*cs.scale)/2;cs.oy=(cs.size-cs.img.height*cs.scale)/2;document.getElementById('zs').value=cs.scale;drawC()}
function clampC(){if(!cs.img)return;cs.min=Math.min(cs.size/cs.img.width,cs.size/cs.img.height)*0.5;cs.scale=Math.max(cs.min,Math.min(cs.max,cs.scale));const w=cs.img.width*cs.scale,h=cs.img.height*cs.scale;if(w<=cs.size)cs.ox=(cs.size-w)/2;else{cs.ox=Math.min(0,Math.max(cs.size-w,cs.ox))}if(h<=cs.size)cs.oy=(cs.size-h)/2;else{cs.oy=Math.min(0,Math.max(cs.size-h,cs.oy))}}

cc.addEventListener('mousedown',e=>{cs.drag=true;cs.lx=e.clientX;cs.ly=e.clientY});
window.addEventListener('mousemove',e=>{if(!cs.drag)return;cs.ox+=e.clientX-cs.lx;cs.oy+=e.clientY-cs.ly;cs.lx=e.clientX;cs.ly=e.clientY;clampC();drawC()});
window.addEventListener('mouseup',()=>cs.drag=false);
cc.addEventListener('touchstart',e=>{e.preventDefault();const t=e.touches[0];cs.drag=true;cs.lx=t.clientX;cs.ly=t.clientY},{passive:false});
cc.addEventListener('touchmove',e=>{e.preventDefault();if(!cs.drag)return;const t=e.touches[0];cs.ox+=t.clientX-cs.lx;cs.oy+=t.clientY-cs.ly;cs.lx=t.clientX;cs.ly=t.clientY;clampC();drawC()},{passive:false});
cc.addEventListener('touchend',e=>{e.preventDefault();cs.drag=false},{passive:false});

function zoomTo(newS){if(!cs.img)return;const o=cs.scale;cs.scale=newS;const c=cs.size/2;cs.ox=c-(c-cs.ox)*(cs.scale/o);cs.oy=c-(c-cs.oy)*(cs.scale/o);clampC();document.getElementById('zs').value=cs.scale;drawC()}
document.getElementById('zs').addEventListener('input',e=>zoomTo(parseFloat(e.target.value)));
document.getElementById('zIn').addEventListener('click',()=>zoomTo(Math.min(cs.max,cs.scale*1.1)));
document.getElementById('zOut').addEventListener('click',()=>zoomTo(Math.max(cs.min,cs.scale/1.1)));
document.getElementById('zReset').addEventListener('click',fitC);
cc.addEventListener('wheel',e=>{e.preventDefault();zoomTo(cs.scale*(e.deltaY>0?0.9:1.1))},{passive:false});

// Utils
function concatA(arrs){const t=arrs.reduce((s,a)=>s+a.length,0);const r=new Uint8Array(t);let o=0;for(const a of arrs){r.set(a,o);o+=a.length}return r}
function isMusic(n){const l=n.toLowerCase();return MUSIC_EXT.some(e=>l.endsWith(e))}
function getExt(n){const i=n.lastIndexOf('.');return i>0?n.substring(i):''}
function getBase(n){const i=n.lastIndexOf('.');return i>0?n.substring(0,i):n}
function canTag(n){const l=n.toLowerCase();return TAG_EXT.some(e=>l.endsWith(e))}
function enc16(s){const b=new Uint8Array(s.length*2);for(let i=0;i<s.length;i++){const c=s.charCodeAt(i);b[i*2]=c&0xFF;b[i*2+1]=(c>>8)&0xFF}return b}

// ID3v2
function readSS(v,o){return(v.getUint8(o)<<21)|(v.getUint8(o+1)<<14)|(v.getUint8(o+2)<<7)|v.getUint8(o+3)}
function writeSS(a,o,v){a[o]=(v>>21)&0x7F;a[o+1]=(v>>14)&0x7F;a[o+2]=(v>>7)&0x7F;a[o+3]=v&0x7F}

function parseID3(buf){
if(buf.byteLength<10)return null;const v=new DataView(buf);
if(v.getUint8(0)!==0x49||v.getUint8(1)!==0x44||v.getUint8(2)!==0x33)return null;
const ver=v.getUint8(3),flags=v.getUint8(5),sz=readSS(v,6),end=10+sz;
if(end>buf.byteLength)return null;
let off=10;if(flags&0x40){if(ver===3){off=10+4+v.getUint32(10)}else if(ver===4){off=10+readSS(v,10)}}
let fe=end;if(flags&0x10)fe=end-10;
const frames=[];while(off+10<=fe){
const id=String.fromCharCode(v.getUint8(off),v.getUint8(off+1),v.getUint8(off+2),v.getUint8(off+3));
if(id.charCodeAt(0)===0)break;
let fs=ver===4?readSS(v,off+4):v.getUint32(off+4);
if(fs<=0||off+10+fs>fe)break;
frames.push({id,data:new Uint8Array(buf,off+10,fs).slice()});off+=10+fs}
return{version:ver,frames,tagEnd:end}}

function buildAPIC(bytes,mime){return concatA([new Uint8Array([0]),new TextEncoder().encode(mime+'\0'),new Uint8Array([3]),new Uint8Array([0]),bytes])}
function buildTPE1(artist){return concatA([new Uint8Array([1]),new Uint8Array([0xFF,0xFE]),enc16(artist),new Uint8Array([0,0])])}

function buildTag(frames){
const parts=[];for(const f of frames){const id=new Uint8Array(4);for(let i=0;i<4;i++)id[i]=f.id.charCodeAt(i);const sz=new Uint8Array(4);new DataView(sz.buffer).setUint32(0,f.data.length);parts.push(id,sz,new Uint8Array(2),f.data)}
const af=concatA(parts);const h=new Uint8Array(10);h[0]=0x49;h[1]=0x44;h[2]=0x33;h[3]=3;h[4]=0;h[5]=0;writeSS(h,6,af.length);return concatA([h,af])}

function modifyTags(buf,mods){
const u8=new Uint8Array(buf);const ex=parseID3(buf);let kf=[],as=0;
if(ex){const rm=[];if(mods.artist!==null)rm.push('TPE1');if(mods.artBytes!==null)rm.push('APIC');kf=ex.frames.filter(f=>!rm.includes(f.id));as=ex.tagEnd}
if(mods.artist!==null)kf.push({id:'TPE1',data:buildTPE1(mods.artist)});
if(mods.artBytes!==null)kf.push({id:'APIC',data:buildAPIC(mods.artBytes,mods.artMime)});
return concatA([buildTag(kf),u8.slice(as)])}

async function checkTags(handle){
const file=await handle.getFile();const hb=await file.slice(0,10).arrayBuffer();const v=new DataView(hb);
if(v.byteLength<10||v.getUint8(0)!==0x49||v.getUint8(1)!==0x44||v.getUint8(2)!==0x33)return{hasArt:false,hasArtist:false};
const sz=readSS(v,6);if(sz<=0)return{hasArt:false,hasArtist:false};
const tb=await file.slice(0,10+sz).arrayBuffer();const p=parseID3(tb);if(!p)return{hasArt:false,hasArtist:false};
return{hasArt:p.frames.some(f=>f.id==='APIC'),hasArtist:p.frames.some(f=>f.id==='TPE1')}}

async function genCrop(){
if(!cs.img)return null;const ts=800;const oc=document.createElement('canvas');oc.width=ts;oc.height=ts;const ctx=oc.getContext('2d');
const r=ts/cs.size;ctx.drawImage(cs.img,cs.ox*r,cs.oy*r,cs.img.width*cs.scale*r,cs.img.height*cs.scale*r);
const blob=await new Promise(res=>oc.toBlob(res,'image/jpeg',0.92));const bytes=new Uint8Array(await blob.arrayBuffer());
return{bytes,mime:'image/jpeg',url:URL.createObjectURL(blob)}}

// UI
function resetPreview(){previewData=[];document.getElementById('previewList').innerHTML='';document.getElementById('previewCard').classList.add('hidden');document.getElementById('progWrap').classList.add('hidden');document.getElementById('progBar').style.width='0%';document.getElementById('status').innerText='';document.getElementById('summary').innerText='';document.getElementById('runBtn').disabled=true;document.getElementById('runBtn').innerText='⚠️ Apply Changes to Files'}
function setScanning(v){isScanning=v;document.getElementById('previewBtn').disabled=v||fileHandles.length===0;document.getElementById('pickFolder').disabled=v;document.getElementById('pickFiles').disabled=v;document.querySelectorAll('.tc').forEach(c=>c.style.pointerEvents=v?'none':'auto')}
function updateFileCount(){const el=document.getElementById('fileCount');if(fileHandles.length>0){el.classList.remove('hidden');el.innerText=`${fileHandles.length} music file${fileHandles.length!==1?'s':''} selected (Click again to add more)`}else{el.classList.add('hidden')}}

document.getElementById('mode').addEventListener('change',e=>document.getElementById('charOptions').classList.toggle('hidden',e.target.value==='track'));

document.querySelectorAll('.tc').forEach(c=>{c.addEventListener('click',()=>{const f=c.dataset.f;features[f]=!features[f];c.classList.toggle('active',features[f]);document.getElementById('renameSection').classList.toggle('hidden',!features.rename);document.getElementById('artSection').classList.toggle('hidden',!features.art);document.getElementById('artistSection').classList.toggle('hidden',!features.artist);resetPreview()})});

document.getElementById('pickFolder').addEventListener('click',async()=>{
resetPreview();setScanning(true);try{
dirHandle=await window.showDirectoryPicker({mode:'readwrite'});fileHandles=[];sourceType='folder';
let total=0,music=0;const handles=[];
for await(const entry of dirHandle.values()){if(entry.kind==='file'){total++;if(isMusic(entry.name)){music++;handles.push(entry)}}}
fileHandles=handles;updateFileCount();
}catch(e){}setScanning(false)});

document.getElementById('pickFiles').addEventListener('click',async()=>{
if(sourceType!=='files'){fileHandles=[];sourceType='files';dirHandle=null}
resetPreview();setScanning(true);try{
const files=await window.showOpenFilePicker({multiple:true,types:[{description:'Music',accept:{'audio/*':MUSIC_EXT}}]});
fileHandles.push(...files);updateFileCount();
}catch(e){}setScanning(false)});

document.getElementById('clearFiles').addEventListener('click',()=>{
fileHandles=[];dirHandle=null;sourceType=null;updateFileCount();resetPreview();
});

// Drag & Drop
const dz=document.getElementById('dropZone');
dz.addEventListener('dragover',e=>{e.preventDefault();dz.classList.add('dragover')});
dz.addEventListener('dragleave',()=>dz.classList.remove('dragover'));
dz.addEventListener('drop',async e=>{
e.preventDefault();dz.classList.remove('dragover');
if(sourceType!=='files'){fileHandles=[];sourceType='files';dirHandle=null}
resetPreview();setScanning(true);
if(e.dataTransfer.items){const items=[...e.dataTransfer.items];const handles=[];for(const item of items){if(item.kind==='file'){try{const h=await item.getAsFileSystemHandle();if(h&&h.kind==='file'&&isMusic(h.name))handles.push(h)}catch(err){}}}
fileHandles.push(...handles);updateFileCount();}
setScanning(false);
});

document.getElementById('pickImage').addEventListener('click',()=>document.getElementById('imageInput').click());
document.getElementById('imageInput').addEventListener('change',async(e)=>{
const file=e.target.files[0];if(!file)return;
if(currentObjectUrl)URL.revokeObjectURL(currentObjectUrl);currentObjectUrl=URL.createObjectURL(file);
const img=new Image();img.onload=()=>{cs.img=img;document.getElementById('cropperContainer').classList.remove('hidden');fitC();resetPreview()};img.src=currentObjectUrl});

function getNewName(oldName,mode,count,match){
const base=getBase(oldName),ext=getExt(oldName);let newName=base;
if(mode==='track'){if(!match||base.startsWith(match))newName=base.replace(/^\s*\d{1,3}[._\-\s]*/,'')}
else if(mode==='start'){if(!match||base.startsWith(match))newName=base.substring(count)}
else if(mode==='end'){if(!match||base.endsWith(match))newName=base.substring(0,base.length-count)}
if(!newName.trim())newName=base;return newName+ext}

document.getElementById('previewBtn').addEventListener('click',async()=>{
if(isScanning)return;if(fileHandles.length===0)return alert('Pick a folder or files first.');
if(!features.rename&&!features.art&&!features.artist)return alert('Enable at least one action.');
if(features.art&&!cs.img)return alert('Select and crop an image first.');
if(features.artist&&!document.getElementById('artistName').value.trim())return alert('Enter an artist name.');
resetPreview();setScanning(true);

const mode=document.getElementById('mode').value,count=parseInt(document.getElementById('count').value)||0,match=document.getElementById('match').value.trim();
const skipArt=document.getElementById('skipArt').checked,skipArtist=document.getElementById('skipArtist').checked,artistName=document.getElementById('artistName').value.trim();
const status=document.getElementById('status');document.getElementById('previewCard').classList.remove('hidden');
status.innerText='Scanning files…';status.className='it';

if(features.art){imageData=await genCrop();if(!imageData){setScanning(false);return alert('Error processing image.')};if(coverThumbUrl)URL.revokeObjectURL(coverThumbUrl);coverThumbUrl=imageData.url;document.getElementById('coverThumb').src=coverThumbUrl;document.getElementById('coverPreview').classList.remove('hidden')}
else document.getElementById('coverPreview').classList.add('hidden');

let html='',rc=0,ac=0,arc=0,asc=0,auc=0,asc2=0,arc2=0,asc3=0,auc2=0,ncc=0;
for(const handle of fileHandles){
const oldName=handle.name;if(!isMusic(oldName))continue;
let newName=oldName;if(features.rename)newName=getNewName(oldName,mode,count,match);
const renamed=newName!==oldName;if(renamed)rc++;
let ti={hasArt:false,hasArtist:false};const ct=canTag(oldName);
if((features.art||features.artist)&&ct)ti=await checkTags(handle);
let aa='none';if(features.art){if(!ct){aa='unsup';auc++}else if(ti.hasArt&&skipArt){aa='skip';asc++}else if(ti.hasArt){aa='replace';arc++}else{aa='add';ac++}}
let arA='none';if(features.artist){if(!ct){arA='unsup';auc2++}else if(ti.hasArtist&&skipArtist){arA='skip';asc2++}else if(ti.hasArtist){arA='replace';arc2++}else{arA='set';asc3++}}
const hasChange=renamed||aa==='add'||aa==='replace'||arA==='set'||arA==='replace';
let labels='';
if(aa==='add')labels+=' <span class="m-a">🖼️ art:add</span>';else if(aa==='replace')labels+=' <span class="m-w">🖼️ art:replace</span>';else if(aa==='skip')labels+=' <span class="m-s">🖼️ art:skip</span>';else if(aa==='unsup')labels+=' <span class="m-s">🖼️ art:n/a</span>';
if(arA==='set')labels+=` <span class="m-ar">🎤 "${artistName}"</span>`;else if(arA==='replace')labels+=` <span class="m-w">🎤 replace→"${artistName}"</span>`;else if(arA==='skip')labels+=' <span class="m-s">🎤 skip</span>';else if(arA==='unsup')labels+=' <span class="m-s">🎤 n/a</span>';
const icon=hasChange?'🎵':'⏭️';const cls=hasChange?'':'nc';
if(renamed)html+=`<div class="pi ${cls}"><div class="pi-ic">${icon}</div><div class="pi-d"><div class="pi-n">${newName}</div><div class="pi-m"><span class="m-r">was: ${oldName}</span>${labels}</div></div></div>`;
